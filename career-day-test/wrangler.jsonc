{
  "name": "hope-creator-island",
  "main": "server/worker.mjs",
  "compatibility_date": "2026-11-27",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/index.html", "/api/*", "/studio/server-config.js", "/admin", "/admin/*"]
  },
  "vars": {
    "ALLOWED_ORIGINS": "https://palettecommunity.github.io"
  },
  "durable_objects": {
    "bindings": [{ "name": "ISLAND_LIVE", "class_name": "IslandLive" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["IslandLive"] }],
  "triggers": { "crons": ["17 * * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hope-creator-island",
      "database_id": "REPLACE_WITH_CREATED_D1_DATABASE_ID"
    }
  ]
}
